<resources>
    <!-- Light theme: tactical HUD palette (navy + mesh green + gold + crimson) -->
    <style name="Theme.MeshKachoUtility" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A7A44</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#A8F5C8</item>
        <item name="colorOnPrimaryContainer">#002E14</item>

        <item name="colorSecondary">#8A6A1F</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFE28A</item>
        <item name="colorOnSecondaryContainer">#2B1F00</item>

        <item name="colorTertiary">#B0121C</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <item name="android:windowBackground">#F2F6F3</item>
        <item name="android:colorBackground">#F2F6F3</item>
        <item name="colorOnBackground">#0B131C</item>
        <item name="colorSurface">#F2F6F3</item>
        <item name="colorOnSurface">#0B131C</item>
        <item name="colorSurfaceVariant">#DDE6E0</item>
        <item name="colorOnSurfaceVariant">#46554C</item>

        <!-- Technical condensed headings -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MeshKacho.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.MeshKacho.TitleMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.MeshKacho.TitleLarge</item>
    </style>

    <style name="TextAppearance.MeshKacho.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.MeshKacho.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
